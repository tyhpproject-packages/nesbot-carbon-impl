{
    "name": "tyhpdef/nesbot-carbon-impl",
    "description": "Implementation package for tyhpdef/nesbot-carbon. Require tyhpdef/nesbot-carbon, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "3.14.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/psr-clock": "@dev",
                "tyhpdef/symfony-translation": "@dev",
                "tyhpdef/symfony-clock": "@dev",
                "tyhpdef/symfony-translation-contracts": "@dev",
                "tyhpdef/php-ext-intl": "@dev",
                "tyhpdef/php-ext-dom": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/nesbot-carbon"
        }
    },
    "require": {
        "php": ">=8.2",
        "nesbot/carbon": "3.14.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/psr-clock": "@dev",
        "tyhpdef/symfony-translation": "@dev",
        "tyhpdef/symfony-clock": "@dev",
        "tyhpdef/symfony-translation-contracts": "@dev",
        "tyhpdef/php-ext-intl": "@dev",
        "tyhpdef/php-ext-dom": "@dev"
    }
}
